{
  "name": "vector-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vector Arena — platform belajar vektor & gerak vertikal berbasis kompetisi",
  "scripts": {
    "start": "node server/server.js",
    "test": "node ../scripts/check-links.mjs && node apps-script/test-code-gs.cjs",
    "test:unit": "node --test tests/js/*.test.mjs",
    "test:server": "node --test tests/js/*.test.mjs",
    "build:bank": "python3 scripts/build_bank.py && python3 scripts/trim_bank.py data/questions.json",
    "validate:bank": "python3 scripts/validate_bank.py data/questions.json --report docs/PHYSICS_VALIDATION.md"
  },
  "engines": { "node": ">=20" }
}
